<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Multibanco and MB WAY come from `payment` itself:
         payment.payment_method_multibanco and payment.payment_method_mbway.
         Payshop has no counterpart there. -->
    <record id="payment_icon_payshop" model="payment.method">
        <field name="name">Payshop</field>
        <field name="code">payshop</field>
        <field name="sequence">800</field>
        <field
            name="image"
            type="base64"
            file="payment_portugal/static/img/payshop_icon.png"
        />
    </record>
</odoo>
